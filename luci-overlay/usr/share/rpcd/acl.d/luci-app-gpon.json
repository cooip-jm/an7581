{
	"luci-app-gpon": {
		"description": "Grant access to PON Management",
		"read": {
			"file": {
				"/usr/libexec/pon_helpers.sh": [ "read" ],
				"/usr/libexec/pon_apply_uci.sh": [ "read" ]
			},
			"ubus": {
				"file": [ "list", "read", "exec" ]
			}
		},
		"write": {
			"uci": [ "pon", "pon_auth" ],
			"ubus": {
				"file": [ "exec" ]
			}
		}
	}
}
