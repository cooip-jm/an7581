config global
    option enabled '1'
    option pon_mode 'auto'
    option bosa_chip 'en7572'
    option fec_rx '1'
    option fec_tx '1'
    option aes '1'
    option event_debug '0'
    option init_report '1'

config device
    option name 'pon'
    option ifname 'pon'
    option type 'auto'
    option vid '0'

config omci
    option enabled '1'
    option auto_start '1'
    option pm_flag '0'

config pon_vlan
    option enabled '0'
    option mode 'transparent'
    option vid ''
    option priority '0'
